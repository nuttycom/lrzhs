cabal-version:      2.4
name:               lrzhs
version:            0.1.0.0
synopsis:           Haskell light client library for Zcash
description:        A Haskell FFI wrapper around zcash_client_backend and
                    zcash_client_sqlite providing light client functionality
                    for sending and receiving Zcash payments.

-- A URL where users can report bugs.
-- bug-reports:

-- The license under which the package is released.
-- license:
author:             Kris Nuttycombe
maintainer:         kris@nutty.land

-- A copyright notice.
-- copyright:
-- category:
extra-source-files: CHANGELOG.md

library
    build-depends:
      base >= 4.15.1 && < 4.21,
      bytestring >= 0.11 && < 0.13,
      text >= 1.2.5 && < 2.2,
    hs-source-dirs:   src

    default-language: Haskell2010
    default-extensions:
      GADTs,
      LambdaCase,
      KindSignatures,
      MultiParamTypeClasses,
      OverloadedStrings,
      RankNTypes,
      TupleSections,
      TypeApplications

    exposed-modules:
      Lrzhs,
      Lrzhs.Types
    other-modules:
      Lrzhs.Ffi
    extra-libraries:
      lrzhs_ffi
